entryPoints:
  web:
    address: ":80"

  websecure:
    address: ":443"

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ EMC }}"
      storage: /var/lib/traefik/acme.json
      dnsChallenge:
        provider: netcup

log:
  level: INFO

api:
  dashboard: false